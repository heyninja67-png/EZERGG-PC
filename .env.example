# NEVOZ Provider: serviço local no host de virtualização.
# Mantenha a API escutando em localhost e exponha-a pela Nginx com HTTPS.
NEVOZ_HOST=127.0.0.1
PORT=8080
NEVOZ_DATA_FILE=/var/lib/nevoz-provider/state.json
NEVOZ_PUBLIC_BASE_URL=
NEVOZ_CONSOLE_SECRET=GERADO_AUTOMATICAMENTE_PELO_INSTALADOR

# Primeira instalação: permite que o app registre este dispositivo automaticamente.
# Depois de instalar e registrar os dispositivos autorizados, pode definir false.
NEVOZ_ALLOW_GUEST_ENROLLMENT=true
NEVOZ_MAX_BOOTSTRAP_PER_MINUTE=8
NEVOZ_MAX_MACHINES_PER_DEVICE=1

# Limites apresentados no app. Ajuste aos recursos físicos do host.
NEVOZ_CPU_OPTIONS=2,4,6,8,12,16
NEVOZ_RAM_OPTIONS=4,8,16,32,64
NEVOZ_DISK_OPTIONS=100,250,500,1000,2000

# Imagens-base Windows preparadas por você, com licença válida e drivers VirtIO.
# Cada caminho deve apontar para um disco qcow2 que inicializa em UEFI/TPM 2.0.
NEVOZ_WINDOWS_TEMPLATES_JSON='{"windows-11":"/var/lib/libvirt/images/nevoz-templates/windows-11.qcow2","windows-11-pro":"/var/lib/libvirt/images/nevoz-templates/windows-11-pro.qcow2","windows-11-enterprise":"/var/lib/libvirt/images/nevoz-templates/windows-11-enterprise.qcow2"}'

# GPU dedicada opcional. PCI passthrough exige IOMMU/VFIO no host.
# Troque o exemplo pelo endereço PCI real mostrado por lspci -nn.
NEVOZ_GPU_PROFILES_JSON='{"none":{"label":"Sem GPU dedicada"}}'

LIBVIRT_URI=qemu:///system
LIBVIRT_NETWORK=default
NEVOZ_IMAGES_DIR=/var/lib/libvirt/images/nevoz
NEVOZ_TPM_ENABLED=true

