# API
PORT=8080
NEVOZ_DATA_FILE=/data/nevoz.json
NEVOZ_PAIRING_CODE=ALTERE-POR-UM-CODIGO-ALEATORIO-LONGO
NEVOZ_PROVIDER=none

# Catálogo liberado para o usuário. Não implica hardware disponível automaticamente.
NEVOZ_CPU_OPTIONS=4,8,16
NEVOZ_RAM_OPTIONS=8,16,32,64
NEVOZ_DISK_OPTIONS=100,250,500,1000,2000
NEVOZ_GPU_PROFILES_JSON='{"none":{"label":"Sem GPU","hostpci":""}}'

# Proxmox VE: habilite somente depois de preparar nós, storage, rede, token e templates Windows licenciados.
# O mapa deve apontar para um template VM existente para cada edição Windows.
PROXMOX_URL=https://proxmox.exemplo.local:8006
PROXMOX_TOKEN_ID=nevoz@pve!api
PROXMOX_TOKEN_SECRET=COLOQUE_O_SEGREDO_AQUI
PROXMOX_NODE=pve-node
PROXMOX_STORAGE=local-lvm
PROXMOX_TEMPLATE_MAP_JSON='{"windows-11":9001,"windows-11-pro":9002,"windows-11-enterprise":9003}'
PROXMOX_TEMPLATE_DISK_GB=100
PROXMOX_BRIDGE=vmbr0

# Opcional: URL de um gateway remoto seguro (ex.: Apache Guacamole), contendo {vmid}.
# Exemplo: https://desktop.exemplo.com/connect?vmid={vmid}
NEVOZ_CONNECTION_URL_TEMPLATE=
